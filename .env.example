# 모델은 이 파일만 바꿔서 전환한다 (코드 수정 없음). 서버 시작 때 app_6_1/llm.py가 설정을 검사하고
# 두 모델에 짧게 연결해 보므로, 이름 오타·키 오류는 면접 도중이 아니라 시작할 때 바로 알 수 있다.
# 진행 중인 면접은 시작할 때 DB에 저장한 모델을 계속 쓰고, 바꾼 설정은 새 면접부터 적용된다.

# ---- 테스트 (무료, 기본) ----
LLM_PROVIDER=ollama
LLM_EVAL_MODEL=qwen3:4b          # 면접 질문·꼬리질문·판정, 서류 평가, 코딩 문제 생성
LLM_FAST_MODEL=qwen3:1.7b          # 30초 대체, 평가 근거 검증(평가와 다른 모델), 챗봇

# ---- 운영 (유료, 2026-11-04 결정: Claude) — 위 세 줄 대신 아래를 쓰면 됨 ----
# LLM_PROVIDER=anthropic
# LLM_EVAL_MODEL=claude-sonnet-5-5
# LLM_FAST_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=                # 키는 이 파일에만. 저장소에 올리지 않음

# ---- 공통 (유료로 바꿔도 그대로) ----
OLLAMA_BASE_URL=http://ollama:11434
LLM_LOCAL_FAST_MODEL=qwen3:1.7b      # 사내 모델의 30초 대체 (사내 평가 모델은 면접 설정 llm_local_model, 기본 qwen3:4b)
EMBED_MODEL=bge-m3                 # FAQ 임베딩 1024차원. 유료 전환과 상관없이 유지
EMBED_DIM=1024
LLM_FALLBACK_SEC=30
LLM_ERROR_SEC=60

# ---- 실행 환경 (compose.yml) ----
POSTGRES_PASSWORD=devpass-change-me    # 개발용. 운영은 다른 값
DATABASE_URL=postgresql://recruit:devpass-change-me@postgres:5432/recruit
REDIS_URL=redis://redis:6379/0
MODULE_MODE=stub                   # stub: 가짜 질문·판정·평가 (GPU 없이) / real: 실제 LLM 질문 생성·판정 (api/real_modules.py, Ollama 필요)
# 음성. stub: 답변 대신 key_points 일부를 넣은 고정 답변·질문은 브라우저 음성 / real: stt 컨테이너(faster-whisper, GPU)·tts 컨테이너(Supertonic)
STT_MODE=stub
TTS_MODE=stub
TTS_URL=http://tts:8000
# # COMPOSE_FILE=compose.yml;compose.ollama.yml   # real 모드: 이 PC GPU의 사내 모델(Ollama)도 함께 띄움
COMPOSE_PROFILES=voice             # real로 쓸 때 주석을 풀면 stt(GPU)·tts 컨테이너도 뜬다
JWT_SECRET=dev-only-jwt-secret-change-me-32bytes+   # 임시 로그인 JWT 서명 키(32바이트 이상). 운영은 긴 임의 값
JUDGE_URL=http://judge:8090          # 코딩 테스트 채점 실행기 (compose judge 서비스, 내부망)
AUDIO_DIR=/audio                   # 답변 음성 임시 위치 (api·worker 공유 볼륨). STT 뒤 바로 지움
DEV_QUICK_LOGIN=1                  # 개발 전용: 로그인 화면의 시험 계정 바로 로그인 버튼. 운영에서는 지운다

# ---- 문의하기 챗봇 (면접 질문·판정 모델과 별개) ----
# 키를 비워 두면 챗봇 대신 규칙 안내로 답한다. 해외 전송에 동의하지 않은 응시도 규칙 안내만 (IV-23)
CHATBOT_MODEL=claude-haiku-5-5
# 코딩 3번 즉석 출제·AI 검증 (같은 ANTHROPIC_API_KEY). 키가 없거나 2번 다 검증에 걸리면 같은 등급 문제 모음으로 대체
CODING_GEN_MODEL=claude-sonnet-5-5
CODING_CHECK_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ---- 간편 가입·로그인 (네이버·구글·카카오 개발자 센터에서 받은 앱 키). 비워 두면 그 버튼은 꺼진다 ----
# 각 개발자 센터에 등록할 돌아올 주소(Redirect URI): {PUBLIC_URL}/api/auth/social/naver|google|kakao/callback
PUBLIC_URL=http://localhost:3000
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오: ID 칸에는 REST API 키, SECRET 칸은 카카오에서 Client Secret을 켰을 때만. 값 없이 = 뒤에 주석을 붙이면 주석이 값으로 읽힘
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# CE·NLI 판정 서버 (nli 컨테이너, 11/9 추가). 비우면 CE는 측정 안 함, NLI는 사내 LLM이 대신
NLI_URL=http://nli:8000

# 얼굴 대조: stub(늘 일치) / real(face 컨테이너 InsightFace buffalo_l, 11/16)
FACE_MODE=stub
